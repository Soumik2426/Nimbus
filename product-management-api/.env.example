# Spring Profile
SPRING_PROFILES_ACTIVE=dev

# Database
DB_URL=jdbc:postgresql://localhost:5433/product_db
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password

# JWT
JWT_SECRET=your_jwt_secret
JWT_EXPIRATION=your_jwt_expiration

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Mail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=phishingguardian.noreply@gmail.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_FROM=phishingguardian.noreply@gmail.com
OTP_TTL_MINUTES=5
